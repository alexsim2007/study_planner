<h1>Регистрация</h1>

<% if @user.errors.any? %>
  <div>
    <h2>Не удалось зарегистрироваться:</h2>

    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @user, url: register_path, html: { class: "glass-form" } do |form| %>
  <div>
    <%= form.label :name, "Имя" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :email, "Email" %>
    <%= form.email_field :email %>
  </div>

  <div>
    <%= form.label :password, "Пароль" %>
    <%= form.password_field :password %>
  </div>

  <div>
    <%= form.label :password_confirmation, "Подтверждение пароля" %>
    <%= form.password_field :password_confirmation %>
  </div>

  <%= form.submit "Зарегистрироваться" %>
<% end %>

<p>
  Уже есть аккаунт?
  <%= link_to "Войти", login_path %>
</p>