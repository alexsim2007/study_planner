<%= turbo_frame_tag "dashboard_statistics" do %>
<% nearest_task = user.upcoming_tasks.first %>
<section class="dashboard-grid">
  <article class="glass stat-card">
    <span class="stat-card__label">Всего задач</span>
    <strong class="stat-card__value">
      <%= user.total_tasks_count %>
    </strong>

    <span class="stat-card__hint">
      <%= user.total_tasks_count.zero? ? "Пока задач нет" : "Всего учебных задач" %>
    </span>
  </article>

  <article class="glass stat-card">
    <span class="stat-card__label">Выполнено</span>
    <strong class="stat-card__value">
      <%= user.completed_tasks_count %>
    </strong>

    <span class="stat-card__hint">
  Выполненных заданий
</span>
  </article>

  <article class="glass stat-card">
    <span class="stat-card__label">Ближайший дедлайн</span>
    <% if nearest_task %>
      <strong class="stat-card__value">
        <%= nearest_task.deadline.strftime("%d.%m") %>
      </strong>

      <span class="stat-card__hint">
        <%= nearest_task.title %>
      </span>
    <% else %>
      <strong class="stat-card__value">—</strong>

      <span class="stat-card__hint">
    Дедлайнов пока нет
  </span>
    <% end %>
  </article>
</section>
<% end %>
