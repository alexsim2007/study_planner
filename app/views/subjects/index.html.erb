<header class="page-header">
  <div>
    <p class="eyebrow">SUBJECTS</p>
    <h1>Мои предметы</h1>
    <p>Все учебные дисциплины в одном месте.</p>
  </div>
</header>


<section class="glass subject-create">
  <h2>Добавить предмет</h2>

  <%= form_with model: @subject, url: subjects_path do |form| %>

    <% if @subject.errors.any? %>
      <div class="form-errors">
        <% @subject.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div class="subject-create__form">
      <%= form.text_field :name,
                          placeholder: "Например, Базы данных" %>

      <%= form.submit "Добавить", class: "button" %>
    </div>

  <% end %>
</section>


<% if @subjects.any? %>

  <div class="subjects-grid">

    <% @subjects.each do |subject| %>

      <article class="glass subject-card">

        <div class="subject-card__icon">
          <%= subject.name.first.upcase %>
        </div>

        <div class="subject-card__body">

          <h2><%= subject.name %></h2>

          <span>
            <%= subject.tasks.count %>
            заданий
          </span>

          <div class="progress">
            <div
              class="progress__bar"
              style="width: <%= subject.progress_percentage %>%"
            ></div>
          </div>

          <div class="progress__text">
            <span>Прогресс</span>

            <strong>
              <%= subject.progress_percentage %>%
            </strong>
          </div>

          <%= button_to "Удалить",
                        subject_path(subject),
                        method: :delete,
                        class: "subject-delete",
                        form: {
                          data: {
                            turbo_confirm: "Удалить предмет?"
                          }
                        } %>

        </div>

      </article>

    <% end %>

  </div>

<% else %>

  <section class="glass empty-state">
    <h3>Предметов пока нет</h3>

    <p>
      Добавь первый предмет с помощью формы выше.
    </p>
  </section>

<% end %>