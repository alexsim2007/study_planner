<header class="page-header page-header--compact">
  <div>
    <p class="eyebrow">NEW TASK</p>
    <h1>Новое задание</h1>
    <p>Добавь информацию о будущем задании.</p>
  </div>
</header>

<section class="glass task-editor">

  <% if @subjects.empty? %>

    <div class="empty-state">
      <h3>Сначала создай предмет</h3>

      <p>
        Задание должно относиться к какому-либо предмету.
      </p>

      <%= link_to "Перейти к предметам",
                  subjects_path,
                  class: "button" %>
    </div>

  <% else %>

    <%= form_with model: @task, url: tasks_path do |form| %>

      <% if @task.errors.any? %>
        <div class="form-errors">
          <% @task.errors.full_messages.each do |message| %>
            <p><%= message %></p>
          <% end %>
        </div>
      <% end %>

      <div class="field field--full">
        <%= form.label :title, "Название" %>

        <%= form.text_field :title,
                            placeholder: "Например, лабораторная работа №4" %>
      </div>


      <div class="field field--full">
        <%= form.label :description, "Описание" %>

        <%= form.text_area :description,
                           rows: 5,
                           placeholder: "Краткое описание задания" %>
      </div>


      <div class="form-grid">

        <div class="field">
          <%= form.label :subject_id, "Предмет" %>

          <%= form.collection_select(
                :subject_id,
                @subjects,
                :id,
                :name,
                { prompt: "Выберите предмет" }
              ) %>
        </div>


        <div class="field">
          <%= form.label :deadline, "Дедлайн" %>

          <%= form.date_field :deadline,
                              value: (@task.deadline || Date.current),
                              min: Date.current.iso8601 %>
        </div>


        <div class="field">
          <%= form.label :priority, "Приоритет" %>

          <%= form.select :priority, [
            ["Низкий", "low"],
            ["Средний", "medium"],
            ["Высокий", "high"]
          ] %>
        </div>


        <div class="field">
          <%= form.label :status, "Статус" %>

          <%= form.select :status, [
            ["Не выполнено", "pending"],
            ["В процессе", "in_progress"],
            ["Выполнено", "completed"]
          ] %>
        </div>

      </div>


      <div class="task-editor__actions">
        <%= link_to "Отмена",
                    tasks_path,
                    class: "button button--secondary" %>

        <%= form.submit "Сохранить",
                        class: "button" %>
      </div>

    <% end %>

  <% end %>

</section>