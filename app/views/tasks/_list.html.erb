<%= turbo_frame_tag "tasks_list" do %>
<% tasks = user.tasks.includes(:subject).order(:deadline, :id) %>
<% if tasks.any? %>

  <section class="glass table-card">

    <div class="table-wrapper">

      <table class="tasks-table">

        <thead>
        <tr>
          <th>Название</th>
          <th>Предмет</th>
          <th>Дедлайн</th>
          <th>Статус</th>
          <th>Приоритет</th>
          <th>Действия</th>
        </tr>
        </thead>

        <tbody>

        <% tasks.each do |task| %>

          <tr>
            <td>
              <%= task.title %>

              <% if task.overdue? %>
                  <span class="overdue-label">
                    Просрочено
                  </span>
              <% end %>
            </td>

            <td>
              <%= task.subject.name %>
            </td>

            <td>
              <%= task.deadline.strftime("%d.%m.%Y") %>
            </td>

            <td>
              <% case task.status %>
              <% when "completed" %>

                  <span class="status status--green">
                    Выполнено
                  </span>

              <% when "in_progress" %>

                  <span class="status status--yellow">
                    В процессе
                  </span>

              <% else %>

                  <span class="status status--red">
                    Не выполнено
                  </span>

              <% end %>
            </td>

            <td>
              <% case task.priority %>
              <% when "high" %>

                  <span class="status status--red">
                    Высокий
                  </span>

              <% when "medium" %>

                  <span class="status status--yellow">
                    Средний
                  </span>

              <% else %>

                  <span class="status status--green">
                    Низкий
                  </span>

              <% end %>
            </td>

            <td>
              <div class="task-actions">

                <% unless task.completed? %>

                  <%= button_to "✓",
                                complete_task_path(task),
                                method: :patch,
                                class: "task-action task-action--complete",
                                title: "Выполнить",
                                aria: { label: "Выполнить задание #{task.title}" } %>

                <% end %>


                <%= button_to "Удалить",
                              task_path(task),
                              method: :delete,
                              class: "task-action task-action--delete",
                              form: {
                                data: {
                                  turbo_confirm: "Удалить задание?"
                                }
                              } %>

              </div>
            </td>
          </tr>

        <% end %>

        </tbody>

      </table>

    </div>

  </section>

<% else %>

  <section class="glass empty-state">
    <h3>Заданий пока нет</h3>

    <p>
      Создай первое задание и оно появится здесь.
    </p>

    <%= link_to "Создать задание",
                new_task_path,
                class: "button", data: { turbo_frame: "_top" } %>
  </section>

<% end %>
<% end %>
